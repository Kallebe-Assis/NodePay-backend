{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // ---- alvo / módulos ----
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,

    // ---- rigor ----
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // ---- só checa tipos; o build é feito pelo tsup ----
    "noEmit": true,
    "sourceMap": true,
    "incremental": true,
    "types": ["node"],

    // ---- código compartilhado vendorizado em ./shared ----
    "baseUrl": ".",
    "paths": {
      "@nodepay/shared": ["./shared/src/index.ts"],
      "@nodepay/shared/*": ["./shared/src/*"]
    }
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts", "test/**/*.ts", "shared/src/**/*.ts"]
}

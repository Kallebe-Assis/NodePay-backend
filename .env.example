# =============================================================================
# NodePay — API (backend/.env)
# Copie para `backend/.env` e preencha. Nunca comite o `.env` real.
# =============================================================================

# ---------- Ambiente ----------
NODE_ENV=development
TZ=America/Sao_Paulo

# ---------- Servidor HTTP ----------
API_HOST=0.0.0.0
API_PORT=3333
# Origem do front, usada no CORS. Em produção: https://seu-front.vercel.app
WEB_ORIGIN=http://localhost:5173

# ---------- Banco de dados (PostgreSQL) ----------
# postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
# Em serverless/pooler, acrescente ?pgbouncer=true&connection_limit=1
DATABASE_URL=

# ---------- Autenticação (JWT) ----------
# Gere segredos:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Custo do hash argon2id (2..4 basta para uma VPS pequena).
PASSWORD_HASH_MEMORY_KIB=19456
PASSWORD_HASH_TIME_COST=2

# ---------- Segredos em repouso (backup/telegram são criptografados no banco) ----------
# 32 bytes base64url:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SECRETS_ENCRYPTION_KEY=

# ---------- Jobs em background (pg-boss, usa o próprio Postgres) ----------
JOBS_ENABLED=false
PGBOSS_SCHEMA=pgboss

# ---------- Relatórios em PDF ----------
# Vazio = a API acha o Chrome/Edge/Chromium do sistema sozinha.
# Preencha só se o navegador estiver num caminho incomum (ex.: /usr/bin/chromium).
PUPPETEER_EXECUTABLE_PATH=

# ---------- Telegram (opcional; também configurável na tela de Configurações) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ENABLED=false

# ---------- Backup em nuvem (Backblaze B2 / S3-compatível — opcional) ----------
BACKUP_ENABLED=false
B2_S3_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=

# =============================================================================
# NodePay — API (backend/.env)
# Copie para `backend/.env` e preencha. Nunca comite o `.env` real.
# =============================================================================

# ---------- Ambiente ----------
NODE_ENV=development
TZ=America/Sao_Paulo

# ---------- Servidor HTTP ----------
API_HOST=0.0.0.0
# Em Render/Railway NAO defina API_PORT nem PORT: a plataforma injeta PORT.
API_PORT=3333
# Origem(ns) do front, usada no CORS. Lista separada por virgula.
# Em producao: https://nodepay-sync.vercel.app
WEB_ORIGIN=http://localhost:5173

# ---------- Banco de dados (PostgreSQL) ----------
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
# NAO deixe colchetes/sinais de menor-maior (< > [ ]) na string -> erro P1013
# "invalid domain character". Troque TODOS os placeholders por valores reais.
#
# Supabase deste projeto (ref bygtbicqexjfxjqmqkbc):
#  - Session pooler  (5432)  <- use este no Render (runtime E migracoes):
#      postgresql://postgres.bygtbicqexjfxjqmqkbc:SUA_SENHA@aws-0-<REGIAO>.pooler.supabase.com:5432/postgres
#      (regiao em Supabase > Project Settings > Database > Connection pooling)
#  - Transaction pooler (6543, +?pgbouncer=true) -> so serverless
#  - Direta (db.bygtbicqexjfxjqmqkbc.supabase.co:5432) -> IPv6-only, NAO funciona no Render
DATABASE_URL=

# ---------- Autenticação (JWT) ----------
# Gere segredos:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Custo do hash argon2id (2..4 basta para uma VPS pequena).
PASSWORD_HASH_MEMORY_KIB=19456
PASSWORD_HASH_TIME_COST=2

# ---------- Segredos em repouso (backup/telegram são criptografados no banco) ----------
# 32 bytes base64url:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SECRETS_ENCRYPTION_KEY=

# ---------- Tarefas agendadas (recorrências, fechar fatura, lembretes, backup) ----------
# Opção A: pg-boss dentro do processo (bom p/ VPS sempre ligada):
JOBS_ENABLED=false
PGBOSS_SCHEMA=pgboss
# Opção B (recomendada no Render/serverless): um scheduler externo chama
#   POST /api/v1/internal/cron/<tarefa>   com header  x-cron-key: <CRON_SECRET>
# Sem CRON_SECRET essas rotas ficam desativadas (404). Gere:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# ---------- Relatórios em PDF ----------
# Vazio = a API acha o Chrome/Edge/Chromium do sistema sozinha.
# No Render NÃO há navegador por padrão: instale um (buildpack/apt) e aponte
# PUPPETEER_EXECUTABLE_PATH, senão a exportação em PDF responde 400 explicando.
PUPPETEER_EXECUTABLE_PATH=

# ---------- Telegram (opcional; também configurável na tela de Configurações) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ENABLED=false

# ---------- Backup em nuvem (Backblaze B2 / S3-compatível — opcional) ----------
BACKUP_ENABLED=false
B2_S3_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=

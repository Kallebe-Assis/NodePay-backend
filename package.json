{
  "name": "nodepay-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NodePay — API (Fastify 5 + Prisma + PostgreSQL). Deployável de forma independente.",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.717.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/sensible": "^6.0.2",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@nodepay/shared": "file:./shared",
    "@prisma/client": "^6.1.0",
    "argon2": "^0.41.1",
    "close-with-grace": "^2.1.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "grammy": "^1.32.0",
    "luxon": "^3.5.0",
    "pg-boss": "^10.1.5",
    "pino": "^9.5.0",
    "prisma": "^6.1.0",
    "puppeteer-core": "^23.10.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.5",
    "pino-pretty": "^13.0.0",
    "vitest": "^2.1.8"
  }
}
